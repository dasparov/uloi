<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record a local speaker saying something worth keeping \u2014 no fixing required."
        android:textSize="13sp"
        android:paddingBottom="10dp" />

    <EditText
        android:id="@+id/acEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Meaning in English (shown as the caption)"
        android:inputType="text"
        android:textSize="16sp"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/acKonkani"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Konkani text (optional)"
        android:inputType="text"
        android:textSize="16sp"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/acTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tag \u2014 e.g. bazaar, petrol pump (optional)"
        android:inputType="text"
        android:textSize="16sp"
        android:importantForAutofill="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/acRecord"
            style="@style/Pill.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            app:icon="@drawable/ic_mic"
            android:text="Record"
            android:textSize="15sp" />

        <com.example.konkani.RecordingMeter
            android:id="@+id/acMeter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:layout_marginStart="14dp"
            android:visibility="gone" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/acConsent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="The speaker agrees this voice may be used to improve Konkani (open dataset)." />
</LinearLayout>

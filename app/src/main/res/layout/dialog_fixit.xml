<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/fixContext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:paddingBottom="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Type the correct Konkani (Bardez / Catholic):"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/fixCorrect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:hint="Correct Konkani \u2014 type it in English letters"
        android:inputType="textMultiLine"
        android:textSize="18sp"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Or have the Konkani speaker record it \u2014 the app plays that recording back as a real local voice."
        android:textSize="13sp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fixRecord"
            style="@style/Pill.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            app:icon="@drawable/ic_mic"
            android:text="Record Konkani voice"
            android:textSize="15sp" />

        <com.example.konkani.RecordingMeter
            android:id="@+id/fixMeter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:layout_marginStart="14dp"
            android:visibility="gone" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/fixConsent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="The speaker agrees this may be used to improve Konkani (open dataset)." />
</LinearLayout>

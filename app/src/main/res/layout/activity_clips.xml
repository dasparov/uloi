<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <TextView
        android:id="@+id/clipsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_clips"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/clipsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white55"
        android:textSize="13sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/clipsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play a native voice to anyone \u2014 the caption tells you what it says."
        android:textColor="@color/white35"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="10dp" />

    <ListView
        android:id="@+id/clipsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false" />
</LinearLayout>

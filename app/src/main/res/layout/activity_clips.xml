<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <TextView
        android:id="@+id/clipsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_clips"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/clipsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white55"
        android:textSize="13sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/clipsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play a local voice to anyone \u2014 the caption tells you what it says."
        android:textColor="@color/white35"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddClip"
            style="@style/Pill.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            app:icon="@drawable/ic_mic"
            android:text="Add clip"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClipsSlow"
            style="@style/Pill.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="50dp"
            android:text="@string/btn_slow"
            android:textSize="14sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/clipsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false" />
</LinearLayout>

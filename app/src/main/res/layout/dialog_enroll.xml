<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record ~30 seconds of your voice (read anything in English is fine). It captures your voice so the app can later speak Konkani in YOUR voice. Cloning activates in Stage 2."
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/enrollRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\uD83C\uDFA4  Record" />

    <CheckBox
        android:id="@+id/enrollConsent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="I agree my voice may be stored and used to build my voice model." />
</LinearLayout>

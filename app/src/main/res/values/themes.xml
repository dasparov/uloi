<resources>
    <style name="Theme.KonkaniTranslator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="colorPrimary">@color/ink</item>
    </style>

    <!-- Glass pill (primary) — icon + label centred as one group, inset from the edge -->
    <style name="Pill.Primary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_strong</item>
        <item name="strokeColor">#33FFFFFF</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">30dp</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="rippleColor">#22FFFFFF</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Glass pill (secondary) -->
    <style name="Pill.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass</item>
        <item name="strokeColor">#26FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">#22FFFFFF</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
